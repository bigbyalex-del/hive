# Copy to .env and fill in.

# Required for the agents to run.
ANTHROPIC_API_KEY=sk-ant-...

# Required later (v0.3) for Whisper STT + TTS.
OPENAI_API_KEY=sk-...

# Optional — Manager model. Defaults to claude-opus-4-7.
HIVE_MANAGER_MODEL=claude-opus-4-7

# Optional — Worker model. Defaults to claude-sonnet-4-6.
HIVE_WORKER_MODEL=claude-sonnet-4-6
